DATABASE_URL="file:C:/Users/your-user/AppData/Local/JobPilot/jobpilot.db"
JOBPILOT_MODEL_BASE_URL="https://kuaipao.pro/v1"
JOBPILOT_MODEL_API_KEY="your-key-here"
JOBPILOT_MODEL_NAME="gpt-5.6-sol"
JOBPILOT_MODEL_REASONING="light"
# Shared site-access gate: sha256 of the access password users type to reach the sign-in page.
JOBPILOT_ACCESS_PASSWORD_HASH="sha256-of-your-access-password"
# Set to 1 to additionally accept a real official vacancy whose page the model did not visibly cite,
# but which independently answers over http(s) (SSRF-guarded: private/loopback hosts are rejected).
# Leave unset to only trust hosts the model demonstrably browsed.
JOBPILOT_VERIFY_URLS="1"
JOBPILOT_SESSION_SECRET="random-session-signing-secret"
JOBPILOT_OWNER_EMAIL="owner@example.com"
JOBPILOT_JOB_SEARCH_URL="https://your-job-search-adapter.example/api/search"
# Gmail one-click OAuth ("用 Google 连接"). JOBPILOT_PUBLIC_URL is your app's public origin and is used to
# build the redirect URI (<origin>/api/oauth/google/callback) — it must EXACTLY match a redirect URI you
# register in the Google Cloud OAuth client. The client id/secret come from that same OAuth client.
JOBPILOT_PUBLIC_URL="https://your-app.example"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Central platform sender via Resend. Non-Gmail users need no mailbox configuration: the applicant's email
# is used as Reply-To and receives a BCC copy of every relayed message.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="jobpilot@your-domain.example"
