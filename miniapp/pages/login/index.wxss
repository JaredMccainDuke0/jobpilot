page{background:#eef2f5;color:#111a24}.page{min-height:100vh;padding:104rpx 44rpx}.hero{display:flex;flex-direction:column;gap:22rpx;margin-bottom:64rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:64rpx;line-height:1.04;font-weight:700;letter-spacing:-3rpx}.muted{font-size:28rpx;color:#687586;line-height:1.6}.card{padding:40rpx;border-radius:32rpx;background:rgba(255,255,255,.82);box-shadow:0 24rpx 60rpx rgba(24,42,64,.12)}.label{display:block;font-size:26rpx;font-weight:600;margin-bottom:16rpx}.input{height:104rpx;padding:0 24rpx;border:2rpx solid #d9e0e8;border-radius:18rpx;font-size:30rpx;margin-bottom:24rpx}.primary{height:104rpx;line-height:104rpx;background:#0758bb;color:#fff;border-radius:18rpx;font-weight:700}.error{display:block;color:#c4323e;font-size:26rpx;line-height:1.5;margin-top:20rpx}
