page{background:#eef2f5;color:#111a24}.page{padding:100rpx 44rpx;display:flex;flex-direction:column;gap:24rpx}.hero{display:flex;flex-direction:column;gap:22rpx;margin-bottom:30rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:52rpx;line-height:1.08;font-weight:700;word-break:break-all}.muted{font-size:28rpx;color:#687586;line-height:1.6}.grid{display:flex;flex-direction:column;gap:20rpx}.card{padding:34rpx;border-radius:28rpx;background:rgba(255,255,255,.82);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09)}.action{position:relative}.card-title{display:block;font-size:34rpx;font-weight:700;margin-bottom:14rpx}.arrow{position:absolute;right:34rpx;top:34rpx;font-size:42rpx;color:#0758bb}.loading{padding-top:200rpx;text-align:center;color:#687586}.error{display:block;color:#c4323e;margin-bottom:20rpx;line-height:1.5}.card button{margin-top:20rpx}
