page{background:#eef2f5;color:#111a24}.page{padding:72rpx 44rpx}.hero{display:flex;flex-direction:column;gap:18rpx;margin-bottom:36rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:56rpx;font-weight:700;line-height:1.1}.card{padding:34rpx;border-radius:28rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09)}.label{display:block;font-size:26rpx;font-weight:600;margin:24rpx 0 12rpx}.input,.textarea{width:100%;box-sizing:border-box;border:2rpx solid #d9e0e8;border-radius:18rpx;background:#fff;font-size:29rpx}.input{height:94rpx;padding:0 22rpx}.textarea{height:180rpx;padding:22rpx}.primary{margin-top:32rpx;height:104rpx;line-height:104rpx;background:#0758bb;color:#fff;border-radius:18rpx;font-weight:700}.error,.success{display:block;font-size:26rpx;line-height:1.5;margin-top:20rpx}.error{color:#c4323e}.success{color:#247a4a}
