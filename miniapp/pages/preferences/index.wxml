<view class="page"><view class="hero"><text class="eyebrow">PREFERENCES</text><text class="title">告诉我们你想找什么</text></view><view class="card"><text class="label">求职描述</text><textarea class="textarea" data-field="rawText" bindinput="onInput" placeholder="例如：深圳现场办公，AI 应用或算法工程师"/><text class="label">目标城市</text><input class="input" data-field="city" bindinput="onInput" placeholder="深圳"/><text class="label">岗位方向</text><input class="input" data-field="jobType" bindinput="onInput" placeholder="AI 工程师"/><text class="label">行业</text><input class="input" data-field="industry" bindinput="onInput" placeholder="不限"/><text class="label">工作方式</text><input class="input" data-field="workMode" bindinput="onInput" placeholder="现场"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存求职条件</button><text wx:if="{{success}}" class="success">{{success}}</text><text wx:if="{{error}}" class="error">{{error}}</text></view></view>
