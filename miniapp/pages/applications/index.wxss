page{background:#eef2f5;color:#111a24}.page{padding:72rpx 44rpx}.hero{display:flex;flex-direction:column;gap:18rpx;margin-bottom:36rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:58rpx;font-weight:700}.card{padding:30rpx;border-radius:26rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09);margin-bottom:18rpx}.card-title{display:block;font-size:32rpx;font-weight:700;margin-bottom:12rpx}.company{display:block;color:#687586;font-size:27rpx}.status{display:inline-block;margin-top:16rpx;padding:8rpx 16rpx;border-radius:999rpx;background:#e9f3ff;color:#0758bb;font-size:24rpx}.loading{text-align:center;color:#687586;padding-top:220rpx}.error{display:block;color:#c4323e;margin-bottom:20rpx}
