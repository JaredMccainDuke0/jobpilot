<view class="page"><view class="hero"><text class="eyebrow">APPLICATIONS</text><text class="title">投递记录</text></view><view wx:if="{{loading}}" class="loading">正在载入投递记录…</view><view wx:elif="{{error}}" class="card"><text class="error">{{error}}</text><button bindtap="load">重试</button></view><view wx:elif="{{!tasks.length}}" class="card"><text class="card-title">暂无投递记录</text></view><view wx:else><view wx:for="{{tasks}}" wx:key="id" class="card"><text class="card-title">{{item.jobTitle}}</text><text class="company">{{item.company}}</text><text class="status">{{item.status}}</text></view></view></view>
