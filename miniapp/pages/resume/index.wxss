page{background:#eef2f5;color:#111a24}.page{padding:78rpx 44rpx}.hero{display:flex;flex-direction:column;gap:20rpx;margin-bottom:44rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:58rpx;font-weight:700}.muted{font-size:27rpx;color:#687586;line-height:1.6}.card{padding:34rpx;border-radius:28rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09)}.primary{height:104rpx;line-height:104rpx;background:#0758bb;color:#fff;border-radius:18rpx;font-weight:700}.error,.success{display:block;font-size:26rpx;line-height:1.5;margin-top:20rpx}.error{color:#c4323e}.success{color:#247a4a}
