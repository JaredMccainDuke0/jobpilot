<view class="page"><view class="hero"><text class="eyebrow">RESUME</text><text class="title">上传你的简历</text><text class="muted">支持 PDF、DOCX 和 TXT，服务器会按你的账户保存并解析。</text></view><view class="card"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="chooseResume">选择简历文件</button><text wx:if="{{success}}" class="success">{{success}}</text><text wx:if="{{error}}" class="error">{{error}}</text></view></view>
