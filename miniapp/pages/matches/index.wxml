<view class="page"><view class="hero"><text class="eyebrow">MATCHES</text><text class="title">公开邮箱岗位</text><text class="muted">仅显示来源页面已核验招聘邮箱的真实岗位。</text><button class="primary" loading="{{searching}}" disabled="{{searching}}" bindtap="search">开始 / 重新搜索</button></view><view wx:if="{{loading}}" class="loading">正在载入匹配结果…</view><view wx:elif="{{error}}" class="card"><text class="error">{{error}}</text><button bindtap="load">重试</button></view><block wx:else><view wx:if="{{!state.run || !state.run.results || !state.run.results.length}}" class="card"><text class="card-title">暂无新的匹配结果</text><text class="muted">请先确认简历并设置求职条件。</text></view><view wx:else class="list"><view wx:for="{{state.run.results}}" wx:key="id" class="card selectable" data-id="{{item.id}}" bindtap="toggle"><view class="check {{item.selected ? 'checked' : ''}}"></view><view><text class="card-title">{{item.job.title}}</text><text class="company">{{item.job.company}} · {{item.job.city}}</text><text class="muted">{{item.job.applicationEmail}}</text></view></view></view></block></view>
