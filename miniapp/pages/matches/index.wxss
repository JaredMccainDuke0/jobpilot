page{background:#eef2f5;color:#111a24}.page{padding:78rpx 44rpx}.hero{display:flex;flex-direction:column;gap:20rpx;margin-bottom:34rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:58rpx;font-weight:700}.muted{font-size:27rpx;color:#687586;line-height:1.6}.primary{height:96rpx;line-height:96rpx;background:#0758bb;color:#fff;border-radius:18rpx;font-weight:700;margin-top:10rpx}.card{padding:32rpx;border-radius:26rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09);margin-bottom:18rpx}.selectable{display:grid;grid-template-columns:42rpx 1fr;gap:20rpx}.check{width:34rpx;height:34rpx;border:3rpx solid #b8c3cf;border-radius:10rpx;margin-top:4rpx}.check.checked{background:#0758bb;border-color:#0758bb;box-shadow:inset 0 0 0 8rpx #fff}.card-title{display:block;font-size:32rpx;font-weight:700;margin-bottom:12rpx}.company{display:block;color:#111a24;font-size:27rpx;margin-bottom:8rpx}.detail{height:68rpx;line-height:68rpx;padding:0 20rpx;font-size:24rpx;color:#0758bb;background:#eef6ff;border:0;border-radius:12rpx;margin-top:16rpx}.loading{text-align:center;color:#687586;padding-top:160rpx}.error{display:block;color:#c4323e;line-height:1.5;margin-bottom:20rpx}
