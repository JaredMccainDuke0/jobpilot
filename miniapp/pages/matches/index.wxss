page{background:#eef2f5;color:#111a24}.page{padding:78rpx 44rpx}.hero{display:flex;flex-direction:column;gap:20rpx;margin-bottom:34rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#0758bb;font-weight:700}.title{font-size:58rpx;font-weight:700}.muted{font-size:27rpx;color:#687586;line-height:1.6}.card{padding:32rpx;border-radius:26rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09);margin-bottom:18rpx}.card-title{display:block;font-size:32rpx;font-weight:700;margin-bottom:12rpx}.company{display:block;color:#111a24;font-size:27rpx;margin-bottom:8rpx}.loading{text-align:center;color:#687586;padding-top:240rpx}.error{display:block;color:#c4323e;line-height:1.5;margin-bottom:20rpx}
