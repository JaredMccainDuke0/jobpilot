<view class="page"><view wx:if="{{loading}}" class="loading">正在载入岗位详情…</view><view wx:elif="{{error}}" class="card"><text class="error">{{error}}</text><button bindtap="load">重试</button></view><view wx:else><view class="hero"><text class="eyebrow">VERIFIED RECRUITMENT EMAIL</text><text class="title">{{job.title}}</text><text class="company">{{job.company}} · {{job.city}}</text></view><view class="card"><text class="label">公开招聘邮箱</text><text class="email">{{job.applicationEmail}}</text><text class="label">来源</text><text class="muted">{{job.source.name}}</text><text class="label">来源地址</text><text class="muted">{{job.source.url}}</text></view></view></view>
