page{background:#eef2f5;color:#111a24}.page{padding:72rpx 44rpx}.hero{display:flex;flex-direction:column;gap:18rpx;margin-bottom:34rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#0758bb;font-weight:700}.title{font-size:58rpx;font-weight:700;line-height:1.08}.company{font-size:29rpx;color:#687586}.card{padding:34rpx;border-radius:28rpx;background:rgba(255,255,255,.84);box-shadow:0 18rpx 44rpx rgba(24,42,64,.09)}.label{display:block;font-size:24rpx;font-weight:700;color:#687586;margin:24rpx 0 10rpx}.email{display:block;font-size:32rpx;color:#0758bb;word-break:break-all}.muted{font-size:27rpx;color:#687586;line-height:1.6;word-break:break-all}.loading{text-align:center;color:#687586;padding-top:220rpx}.error{display:block;color:#c4323e;margin-bottom:20rpx}
