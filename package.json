{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Real job matching and email application assistant with resume parsing and verified job sources.",
  "repository": {
    "type": "git",
    "url": "https://github.com/VELIR5/jobpilot.git"
  },
  "homepage": "https://github.com/VELIR5/jobpilot",
  "bugs": {
    "url": "https://github.com/VELIR5/jobpilot/issues"
  },
  "license": "MIT",
  "keywords": [
    "job-search",
    "resume-parser",
    "nextjs",
    "wechat-mini-program",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:miniapp": "node scripts/check-miniapp.mjs",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm run test && npm run check:miniapp && npm run audit",
    "catalog:refresh": "tsx scripts/refresh-catalog.ts",
    "catalog:worker": "tsx scripts/catalog-worker.ts",
    "db:push": "tsx prisma/seed.ts --init-only",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
